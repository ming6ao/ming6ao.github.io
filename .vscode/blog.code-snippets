{
  "Frontmatter": {
    "scope": "markdown",
    "prefix": "frontmatter",
    "body": [
      "---",
      "title: $1",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND$CURRENT_TIMEZONE_OFFSET",
      "description: $2",
      "tags:",
      "  - $3",
      "featured: ${4|false,true|}",
      "draft: ${5|true,false|}",
      "author: Ming6ao",
      "---",
    ],
    "description": "Insert blog post frontmatter. See docs/writing-posts.md for field descriptions.",
  },
  "Blog template": {
    "scope": "markdown",
    "prefix": "template",
    "body": [
      "${1:frontmatter}",
      "",
      "${2:Introductory sentence.}",
      "",
      "## Table of contents",
      "",
      "## ${3:First heading}",
      "",
    ],
    "description": "Insert a post skeleton. Trigger the snippet menu again on the frontmatter line to fill in the details.",
  },
}
