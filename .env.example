# Copy this file to `.env` and fill in values for local development.
# `.env` is ignored by Git. For deployments, add the same names as repository
# variables under Settings -> Secrets and variables -> Actions -> Variables.

# Google Search Console verification value. Optional. Overrides the
# `site.googleVerification` field in `astro-paper.config.ts`.
PUBLIC_GOOGLE_SITE_VERIFICATION=
